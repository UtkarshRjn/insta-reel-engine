# OpenAI API Key (for script generation)
OPENAI_API_KEY=your_openai_api_key_here

# Grok (xAI Aurora) API Key (for video generation)
# Get your key at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Cloudflare R2 (for video hosting - Instagram needs public URLs)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=reel-engine
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Instagram/Meta App Credentials
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/auth/instagram/callback

# Character consistency (public URL of your character reference image)
# Upload a reference image and paste the URL — used by FLUX and Kling
CHARACTER_REF_IMAGE_URL=

# Scheduler
DAILY_POST_TIME=09:00

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173

# For Railway: set DATA_DIR to a persistent volume path
# DATA_DIR=/data

# --- prompt_library (Phase 2) ---
# Jina CLIP v2 embeddings (multimodal, 1024-dim). Get a key at https://jina.ai/
JINA_API_KEY=
# Optional override if you self-host Jina behind your own gateway.
# JINA_BASE_URL=https://api.jina.ai/v1

# Apify token for Instagram post scraping. Without this, only the oEmbed
# fallback (caption + thumbnail, no music) runs.
APIFY_TOKEN=
# Optional: override the scraper actor.
# APIFY_ACTOR_ID=apify/instagram-post-scraper

# Qdrant Cloud (free 1 GB tier is enough to start).
# Create a cluster at https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=prompt_library

# Build-time tunables
# INDEX_MAX_IMAGES_PER_POST=5
# APIFY_RUN_TIMEOUT_SECS=180
